# 프론트가 호출할 API 베이스 (Cloudflare Worker 엔드포인트)
# 예) https://ward-pillcheck-proxy.<your-subdomain>.workers.dev
VITE_API_BASE=https://ward-pillcheck-proxy.example.workers.dev

# GitHub Pages base 경로 덮어쓰기(선택). 기본값 /ward-pillcheck/
# VITE_BASE=/ward-pillcheck/

# 비워두면 프론트는 자동으로 mock 클라이언트를 사용(인증키 없이 UI 검증 가능).
